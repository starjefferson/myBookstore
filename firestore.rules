rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set this custom claim only from a trusted Admin SDK environment.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shippingZones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /catalogMeta/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Customers can only read their own orders after signing in with the
      // address supplied at checkout. Admins can read all operational orders.
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.buyerEmail == request.auth.token.email);

      // Paid orders are written by the Paystack server route using the Admin SDK
      // (which bypasses these rules). This permits only a zero-payment custom
      // book request to be submitted from the public request form.
      allow create: if isAdmin() ||
        (request.resource.data.orderType == 'request' &&
         request.resource.data.status == 'order_requested' &&
         request.resource.data.totalPaid == 0 &&
         request.resource.data.items.size() == 0);

      allow update, delete: if isAdmin();
    }

    // Payment receipts must never be exposed to a browser client.
    match /paymentReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Default deny: any new collection requires an explicit rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
